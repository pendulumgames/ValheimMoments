<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyVersion>0.15.0.0</AssemblyVersion>
    <Version>0.15.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <Import Project="../../local.props" Condition="Exists('../../local.props')" />
  <ItemGroup>
    <!-- Game resolves its own dependency graph. Compile only against the explicit
         API references below, not the game's unrelated HTTP/compression libraries. -->
    <Reference Include="assembly_valheim"><HintPath>$(GamePath)/valheim_Data/Managed/assembly_valheim.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Reference Include="0Harmony"><HintPath>$(ProfilePath)/BepInEx/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(GamePath)/valheim_Data/Managed/assembly_guiutils.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Reference Include="assembly_utils"><HintPath>$(GamePath)/valheim_Data/Managed/assembly_utils.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Compile Include="../ValheimMoments.Core/CaptureBuffer.cs" Link="Core/CaptureBuffer.cs" />
    <Compile Include="../ValheimMoments.Core/CaptureSession.cs" Link="Core/CaptureSession.cs" />
    <Compile Include="../ValheimMoments.Core/CaptureLimits.cs" Link="Core/CaptureLimits.cs" />
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GamePath)/valheim_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(ProfilePath)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GamePath)/valheim_Data/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)/valheim_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(GamePath)/valheim_Data/Managed/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GamePath)/valheim_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GamePath)/valheim_Data/Managed/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GamePath)/valheim_Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(GamePath)/valheim_Data/Managed/Unity.Collections.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ProfilePath)/BepInEx/core/BepInEx.dll')" Text="Set ProfilePath in local.props to an installed BepInEx profile." />
    <Error Condition="!Exists('$(GamePath)/valheim_Data/Managed/UnityEngine.CoreModule.dll')" Text="Set GamePath in local.props to the Valheim installation." />
  </Target>
</Project>
